    "Nabywca": { "typ": "tekst", "wymagane": true },
    "E-mail kontaktowy": { "typ": "email" },
    "Kwota netto": { "typ": "kwota", "wymagane": true, "min": 0.01, "miejsca_po_przecinku": 2 },
    "Ilość": { "typ": "liczba_calkowita", "wymagane": true, "min": 1, "max": 1000 },
    "Status": { "typ": "tekst", "wymagane": true, "dozwolone": ["nowe", "opłacone", "wysłane", "anulowane"] },
    "Kod pocztowy dostawy": { "typ": "kod_pocztowy", "wymagane": true },
